<!-- IL2CPP (Web builds) strips members it can't see used. Newtonsoft creates these
     models by reflection, so keep them whole, or JSON loading fails silently. -->
<linker>
  <assembly fullname="MuseumBrowser.Core" preserve="all"/>
  <assembly fullname="MuseumBrowser.App" preserve="all"/>
  <!-- Engine-code stripping removes native classes our scripts never name. The kit's wall,
       floor and ceiling prefabs carry colliders that the walking visitor needs. -->
  <assembly fullname="UnityEngine.PhysicsModule">
    <type fullname="UnityEngine.MeshCollider" preserve="all"/>
    <type fullname="UnityEngine.BoxCollider" preserve="all"/>
    <type fullname="UnityEngine.CharacterController" preserve="all"/>
  </assembly>
</linker>
