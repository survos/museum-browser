.hidden { display: none; }
.slideshow {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgb(17, 16, 15);
}
.viewport { position: absolute; left: 0; right: 0; top: 0; bottom: 150px; overflow: hidden; }
.track { flex-direction: row; height: 100%; }
.track.animate { transition-property: translate; transition-duration: 0.35s; transition-timing-function: ease-out-cubic; }
.slide { height: 100%; flex-shrink: 0; padding: 36px 64px 12px 64px; }
.photo { flex-grow: 1; -unity-background-scale-mode: scale-to-fit; }

.info { position: absolute; left: 64px; right: 64px; bottom: 82px; align-items: center; }
.meta { font-size: 14px; color: rgb(200, 169, 106); letter-spacing: 1px; }
.caption { font-size: 18px; color: rgb(239, 233, 221); white-space: normal; -unity-text-align: middle-center; max-width: 1100px; margin-top: 2px; }
.counter { position: absolute; top: 14px; left: 18px; font-size: 13px; color: rgb(150, 142, 128); }
.close {
    position: absolute; top: 12px; right: 14px; width: 38px; height: 38px; border-radius: 19px;
    font-size: 16px; background-color: rgba(250, 248, 243, 0.85); color: rgb(28, 27, 26); border-width: 0;
}

.timeline {
    position: absolute; left: 64px; right: 64px; bottom: 28px; height: 30px;
    border-top-width: 1px; border-top-color: rgb(80, 75, 66);
}
.tick { position: absolute; top: 0; width: 1px; height: 8px; background-color: rgb(120, 112, 100); }
.tick-label { position: absolute; top: 9px; left: -16px; width: 32px; font-size: 11px; color: rgb(150, 142, 128); -unity-text-align: upper-center; }
.dot { position: absolute; top: -3px; width: 2px; height: 5px; margin-left: -1px; background-color: rgba(200, 169, 106, 0.35); }
.marker { position: absolute; top: -9px; width: 3px; height: 18px; margin-left: -1px; background-color: rgb(200, 169, 106); }
