/* Tour guide panel: the stop's story, left side, above the work label (bottom left). */
.tour-panel {
    position: absolute;
    left: 24px;
    top: 24px;
    width: 440px;
    max-height: 58%;
    padding: 20px 24px 16px 24px;
    background-color: rgba(250, 248, 243, 0.94);
    border-radius: 4px;
    color: rgb(28, 27, 26);
    transition-property: opacity, translate;
    transition-duration: 0.25s;
}
.tour-panel > * { flex-shrink: 0; }
.tour-panel.hidden { opacity: 0; translate: -480px 0; }
.tour-counter { font-size: 13px; color: rgb(120, 116, 110); white-space: normal; margin-bottom: 6px; }
.tour-title { font-size: 26px; -unity-font-style: bold; white-space: normal; }
.tour-subtitle { font-size: 17px; -unity-font-style: italic; white-space: normal; margin-top: 4px; }
.tour-address { font-size: 13px; color: rgb(95, 92, 88); white-space: normal; margin-top: 6px; }
.tour-controls { flex-direction: row; margin-top: 12px; }
.tour-button {
    margin: 0 8px 0 0; padding: 6px 12px; border-radius: 3px; font-size: 14px;
    background-color: rgb(42, 40, 37); color: rgb(245, 240, 230); border-width: 0;
}
.tour-button:hover { background-color: rgb(90, 76, 52); }
.tour-button:disabled { opacity: 0.4; }
.tour-recordings { margin-top: 8px; }
.tour-recording {
    margin: 4px 0 0 0; -unity-text-align: middle-left; white-space: normal;
    background-color: rgb(232, 226, 214); color: rgb(28, 27, 26); font-size: 13px;
}
.tour-recording.current { background-color: rgb(200, 169, 106); }
.tour-panel > .tour-scroll { margin-top: 12px; flex-shrink: 1; }
.tour-lede { font-size: 16px; -unity-font-style: italic; white-space: normal; margin-bottom: 10px; }
.tour-story { font-size: 15px; white-space: normal; }
.tour-credit { font-size: 11px; color: rgb(95, 92, 88); white-space: normal; margin-top: 14px; }
